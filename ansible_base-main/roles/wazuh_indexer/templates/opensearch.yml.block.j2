network.host: "{{ wazuh_indexer_network_host }}"
node.name: "{{ wazuh_indexer_node_name }}"
cluster.initial_master_nodes:
{% if wazuh_single_node | bool %}
  - "{{ wazuh_indexer_node_name }}"
{% else %}
{% for node in wazuh_indexer_cluster_initial_master_nodes %}
  - "{{ node }}"
{% endfor %}
{% endif %}
{% if (not wazuh_single_node | bool) and (wazuh_indexer_discovery_seed_hosts | length > 0) %}
discovery.seed_hosts:
{% for host in wazuh_indexer_discovery_seed_hosts %}
  - "{{ host }}"
{% endfor %}
{% endif %}
plugins.security.nodes_dn:
{% if wazuh_single_node | bool %}
  - "CN={{ wazuh_indexer_node_name }},OU=Wazuh,O=Wazuh,L=California,C=US"
{% else %}
{% for dn in wazuh_indexer_nodes_dn %}
  - "{{ dn }}"
{% endfor %}
{% endif %}
